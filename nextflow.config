params {
    input = null
    output = null
    inputType = null
    systems = null
    outputFormat = null
    chunkSize = null

    version = null
    uniprotRelease = null
    iprVersion = null
    iprscanVersion = null

    pirsrRelease = null
    dataPath = null
    forceDownloads = false

    unifireVersion = null
    unifireImage = null

    unifireMemory = null
    pirsrMemory = null
    maxWorkers = null
    iprscan6ProfileName = null

    help = false
}

includeConfig "nextflow/conf/profiles.config"

// Forward Seqera Platform (Tower) credentials to every task environment.
// `process.env` entries are evaluated on the launch node and explicitly
// injected into tasks, which is required for batch executors (awsbatch,
// googlebatch) and containerized tasks, since the environment is not
// inherited there. Vars unset in the parent environment are not forwarded
// (verified: null-valued entries are omitted from task environments).
process {
    env {
        TOWER_ACCESS_TOKEN       = System.getenv('TOWER_ACCESS_TOKEN')
        TOWER_WORKSPACE_ID       = System.getenv('TOWER_WORKSPACE_ID')
        TOWER_BASE_URL           = System.getenv('TOWER_BASE_URL')
        TOWER_CONTAINER_REGISTRY = System.getenv('TOWER_CONTAINER_REGISTRY')
    }
}
