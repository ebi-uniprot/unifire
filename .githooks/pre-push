#!/usr/bin/env bash
#
# Pre-push hook: verifies that for every v* tag, release/* branch or
# snapshot/* branch being pushed, the value of engine.unifireVersion
# committed at that ref matches the tag/branch-derived Docker image tag (via
# the shared --tag mode of the check script) before pushing.
#
# Enable by running:
#   git config core.hooksPath .githooks
#
set -euo pipefail

ZERO_SHA="0000000000000000000000000000000000000000"
CONFIG_REL_PATH="nextflow/defaults.nf"
# Git runs hooks with the working directory set to the repo root, but the
# check script may not be committed in the local clone; resolve it relative
# to this hook's location instead.
REPO_ROOT_FROM_HOOK="$(cd "$(dirname "$0")"/.. && pwd)"
CHECK_SCRIPT="$REPO_ROOT_FROM_HOOK/misc/release/check-nextflow-version.sh"
if [ ! -f "$CHECK_SCRIPT" ]; then
    CHECK_SCRIPT="misc/release/check-nextflow-version.sh"
fi

fail=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    # Only check v* tags and release/* / snapshot/* branches; skip deletions.
    case "$remote_ref" in
        refs/tags/v*|refs/heads/release/*|refs/heads/snapshot/*) ;;
        *) continue ;;
    esac

    if [ -z "${_local_sha:-}" ] || [ "$_local_sha" = "$ZERO_SHA" ]; then
        # Deletion on the remote - nothing to check.
        echo "Skipping deleted ref: ${remote_ref}" >&2
        continue
    fi

    expected="$(bash "$CHECK_SCRIPT" --tag "$remote_ref" --print)"

    # Read the config file as committed at the ref (peel annotated tags).
    ref_commit="$(git rev-parse "${remote_ref}^{commit}")"
    config_blob="$(mktemp)"
    if ! git show "${ref_commit}:${CONFIG_REL_PATH}" > "$config_blob" 2>/dev/null; then
        echo "ERROR: ref '${remote_ref}' does not contain '${CONFIG_REL_PATH}'" >&2
        rm -f "$config_blob"
        fail=1
        continue
    fi

    echo "Checking '${CONFIG_REL_PATH}' at '${remote_ref}' (expect version '${expected}')" >&2
    if ! bash "$CHECK_SCRIPT" --tag "$remote_ref" "$config_blob"; then
        fail=1
    fi
    rm -f "$config_blob"
done

exit "$fail"
