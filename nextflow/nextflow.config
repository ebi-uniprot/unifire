params {
    input = null
    output = null
    inputType = "fasta"
    uniprotRelease = "2026_02"
    dataPath = null
    useUrml = true
    useArba = true
    usePirsr = true
    skipDownloads = false

    unifireVersion = "latest"
}

includeConfig "conf/profiles/base.config"

profiles {
    docker {
        includeConfig "conf/profiles/docker.config"
    }
}
