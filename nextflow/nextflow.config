includeConfig "conf/versions.config"
includeConfig "conf/defaults.config"

params {
    input = null
    output = null
    inputType = null

    version = null
    uniprotRelease = null
    iprVersion = null
    iprscanVersion = null

    pirsrRelease = null
    dataPath = params.defaultDataPath
    systems = params.defaultSystems
    skipDownloads = false
    chunkSize = params.defaultChunkSize

    unifireVersion = params.defaultUnifireVersion
    unifireImage = params.defaultUnifireImage

    unifireMemory = null
    pirsrMemory = null
    maxWorkers = null
    iprscan6ProfileName = "docker"
    outputFormat = params.defaultOutputFormat

    help = false
}

includeConfig "conf/profiles/base.config"

profiles {
    docker {
        includeConfig "conf/profiles/docker.config"
    }
    singularity {
        includeConfig "conf/profiles/singularity.config"
    }
    podman {
        includeConfig "conf/profiles/podman.config"
    }
}
