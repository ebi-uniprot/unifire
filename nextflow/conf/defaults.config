params {
    defaultIprscanVersion = "6.0.1"
    defaultIprVersion = "latest"

    defaultSystems = "unirule,arba,pirsr"
    defaultUniprotRelease = "latest"
    defaultChunkSize = 500
    defaultOutputFormat = "TSV"
    defaultUnifireVersion = "latest"
    defaultUnifireImage = "dockerhub.ebi.ac.uk/uniprot-public/unifire/nextflow"
    defaultDataPath = ".unifire/data"
}
