// Profile for running the pipeline locally inside the standalone UniFIRE
// image (ghcr.io/ebi-uniprot/unifire/standalone). All dependencies are
// installed in the image itself, so no container engine is used
// (no docker-in-docker). InterProScan6 runs with its base configuration
// (local executor); iprscan6ProfileNames is intentionally left empty.
docker.enabled      = false
singularity.enabled = false
apptainer.enabled   = false
podman.enabled      = false
