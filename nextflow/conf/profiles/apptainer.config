params {
    iprscan6ProfileNames = (params.iprscan6ProfileNames ?: []) + ['apptainer']
}

process {
    withLabel:use_gpu {
        containerOptions = '--nv'
    }
}

apptainer {
    enabled = true
    pullTimeout = '3 hours' // the default is 20 minutes and fails with large images
}

singularity {
    enabled = true
}