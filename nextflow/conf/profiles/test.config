// Profile for smoke tests (nextflow/tests/smoke.py).
// Runs the pipeline with `-stub-run`, so no container engine, Docker
// images, or remote data downloads are required.

params {
    iprscan6ProfileName = "test"
}

docker.enabled = false
apptainer.enabled = false

process {
    withName: 'runUnirulePipeline|rulePirsrPipeline' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { task.executor == "local" ? 48.h : 24.h * task.attempt }
    }
    withName: 'runArbaPipeline' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { task.executor == "local" ? 48.h : 24.h * task.attempt }
    }
}