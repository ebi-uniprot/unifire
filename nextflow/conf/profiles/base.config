executor {
    name = 'local'
    cpus = ({
        return params.maxWorkers != null ? params.maxWorkers : null
    }())
}

process {
    executor        = 'local'
    cpus            = 1
    maxRetries      = 3
    errorStrategy   = { task.exitStatus in ((130..145) + 104) ? "retry" : "finish" }
    withLabel: 'mem_min'        { memory = {  1.GB * task.attempt } }
    withLabel: 'mem_low'        { memory = {  2.GB * task.attempt } }
    withLabel: 'mem_medium'     { memory = {  4.GB * task.attempt } }
    withLabel: 'mem_high'       { memory = {  8.GB * task.attempt } }
    withLabel: 'mem_xhigh'      { memory = { 12.GB * task.attempt } }
    withLabel: 'mem_x2high'     { memory = { 32.GB * task.attempt } }
    withLabel: 'mem_x3high'     { memory = { 48.GB * task.attempt } }
    withLabel: 'mem_x4high'     { memory = { 64.GB * task.attempt } }
    withLabel: 'time_veryshort' { time   = { task.executor == "local" ? 24.h : 1.h  * task.attempt } }
    withLabel: 'time_short'     { time   = { task.executor == "local" ? 24.h : 2.h  * task.attempt } }
    withLabel: 'time_medium'    { time   = { task.executor == "local" ? 24.h : 4.h  * task.attempt } }
    withLabel: 'time_long'      { time   = { task.executor == "local" ? 24.h : 6.h  * task.attempt } }
    withLabel: 'time_xlong'     { time   = { task.executor == "local" ? 48.h : 24.h * task.attempt } }
    withLabel: 'time_x2long'    { time   = { task.executor == "local" ? 72.h : 36.h * task.attempt } }
    withLabel: 'time_x3long'    { time   = { task.executor == "local" ? 96.h : 48.h * task.attempt } }
    withLabel: 'time_max'       { time   = { task.executor == "local" ? 168.h : 168.h } }
    withLabel: 'dynamic'        { cpus   = { params.cpus } }

    withName: 'runUnirulePipeline|rulePirsrPipeline' {
        cpus   = 8
        memory = { 12.GB * task.attempt }
        time   = { task.executor == "local" ? 48.h : 24.h * task.attempt }
    }
    withName: 'runArbaPipeline' {
        cpus   = 16
        memory = { 48.GB * task.attempt }
        time   = { task.executor == "local" ? 48.h : 24.h * task.attempt }
    }
}
